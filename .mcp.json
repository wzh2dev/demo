{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest"
      ]
    },
    "codegraph": {
      "command": "npx",
      "args": [
        "@colbymchenry/codegraph",
        "serve",
        "--mcp"
      ]
    },
    "drawio": {
      "command": "npx",
      "args": [
        "@next-ai-drawio/mcp-server@latest"
      ]
    },
    "gitnexus": {
      "command": "npx",
      "args": [
        "gitnexus@latest",
        "mcp"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--browser=chrome"
      ]
    },
    "dbhub": {
      "command": "npx",
      "args": [
        "@bytebase/dbhub@latest",
        "--dsn",
        "postgres://postgres:postgres@xueyingying.com/demo"
      ]
    },
    "tencent-docs": {
      "url": "https://docs.qq.com/openapi/mcp",
      "headers": {
        "Authorization": "7de167f4ab004c408a81a512674ddca6"
      }
    }
  }
}
