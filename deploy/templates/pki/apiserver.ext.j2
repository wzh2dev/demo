[ v3_req ]
basicConstraints       = critical, CA:FALSE
keyUsage               = critical, digitalSignature, keyEncipherment
extendedKeyUsage       = serverAuth
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid,issuer
subjectAltName         = @alt_names

[ alt_names ]
DNS.1 = localhost
DNS.2 = wuzhenhua.com
DNS.3 = xueyingying.com
DNS.4 = {{ item }}
DNS.5 = {{ item }}.wuzhenhua.com
DNS.6 = kubernetes
DNS.7 = kubernetes.default
DNS.8 = kubernetes.default.svc
DNS.9 = kubernetes.default.svc.wuzhenhua.com
IP.1  = 127.0.0.1
IP.2  = {{ hostvars[item].ansible_host }}
IP.3  = {{ kubernetes_service_ip }}
IP.4  = {{ keepalived_vip }}
