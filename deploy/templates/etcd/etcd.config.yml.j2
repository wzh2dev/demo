# {{ ansible_managed }}
name: {{ inventory_hostname }}
data-dir: /data/etcd
listen-peer-urls: https://{{ ansible_host }}:2380
listen-client-urls: https://{{ ansible_host }}:2379,https://127.0.0.1:2379
advertise-client-urls: https://{{ ansible_host }}:2379
initial-advertise-peer-urls: https://{{ ansible_host }}:2380
initial-cluster: {{ etcd_initial_cluster }}
initial-cluster-token: etcd-cluster
initial-cluster-state: new
client-transport-security:
  cert-file: /cluster/pki/etcd/server-{{ inventory_hostname }}.crt
  key-file: /cluster/pki/etcd/server-{{ inventory_hostname }}.key
  trusted-ca-file: /cluster/pki/etcd/etcd.crt
  client-cert-auth: true
peer-transport-security:
  cert-file: /cluster/pki/etcd/peer-{{ inventory_hostname }}.crt
  key-file: /cluster/pki/etcd/peer-{{ inventory_hostname }}.key
  trusted-ca-file: /cluster/pki/etcd/etcd.crt
  client-cert-auth: true
