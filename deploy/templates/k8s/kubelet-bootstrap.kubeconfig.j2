apiVersion: v1
kind: Config
clusters:
  - name: local
    cluster:
      server: {{ api_server }}
      certificate-authority: /cluster/pki/k8s/k8s.crt
users:
  - name: kubelet-bootstrap
    user:
      token: "abcdef.0123456789abcdef"
contexts:
  - name: kubelet-bootstrap@local
    context:
      cluster: local
      user: kubelet-bootstrap
current-context: kubelet-bootstrap@local
