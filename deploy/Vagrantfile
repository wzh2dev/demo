# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "centos/7"
  config.vm.box_version = "2004.01"
  config.vm.box_check_update = false
  config.vm.provider "vmware_desktop" do |v|
    v.vmx["memsize"] = "4096"
    v.vmx["numvcpus"] = "2"
  end
  config.ssh.insert_key = false

  config.vm.provision "shell", inline: <<-'SHELL'
    sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
    systemctl restart sshd 2>/dev/null
  SHELL

  nodes = {
    "node1" => "10.0.0.101",
    "node2" => "10.0.0.102",
    "node3" => "10.0.0.103"
  }

  nodes.each do |name, ip|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.vm.network "private_network", ip: ip
    end
  end

  config.vm.define "client" do |client|
    client.vm.hostname = "client"
    client.vm.network "private_network", ip: "10.0.0.100"

    client.vm.provision "ansible_local" do |ansible|
      ansible.playbook = "site.yml"
      ansible.host_vars = {
        "node1" => { "ansible_host" => "10.0.0.101" },
        "node2" => { "ansible_host" => "10.0.0.102" },
        "node3" => { "ansible_host" => "10.0.0.103" }
      }
      ansible.limit = "all"
      ansible.groups = {
        "nodes"              => ["node1", "node2", "node3"],
        "etcd"               => ["node1", "node2", "node3"],
        "apiserver"          => ["node1", "node2"],
        "controller_manager" => ["node1", "node2"],
        "scheduler"          => ["node1", "node2"],
        "kubelet"            => ["node1", "node2", "node3"],
        "kube_proxy"         => ["node1", "node2", "node3"]
      }
    end
  end
end
