[global]
fsid = {{ ceph_fsid }}
mon initial members = {{ groups['mons'] | join(', ') }}
mon host = {% for host in groups['mons'] %}{{ hostvars[host].ansible_host }}{% if not loop.last %},{% endif %}{% endfor %}
public network = {{ ceph_public_network }}

auth cluster required = cephx
auth service required = cephx
auth client required = cephx

osd pool default size = {{ ceph_pool_default_size }}
osd pool default min size = {{ ceph_pool_default_min_size }}
osd pool default pg num = {{ ceph_pool_default_pg_num }}
osd pool default pgp num = {{ ceph_pool_default_pgp_num }}
