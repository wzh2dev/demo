# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "centos/7"
  config.vm.box_version = "2004.01"
  config.vm.box_check_update = false
  config.vm.provider "vmware_desktop" do |v|
    v.vmx["numvcpus"] = "2"
    v.vmx["memsize"] = "4096"
  end
  config.ssh.insert_key = false

  bridge = "Intel(R) Ethernet Connection I217-LM"

  config.vm.provision "shell", inline: <<-'SHELL'
    sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
    systemctl restart sshd 2>/dev/null
  SHELL

  nodes = {
    "node1" => "10.0.0.101",
    "node2" => "10.0.0.102",
    "node3" => "10.0.0.103",
  }

  nodes.each do |name, ip|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.vm.network "public_network", ip: ip, netmask: "255.255.255.0", bridge: bridge
    end
  end

  config.vm.define "hub" do |hub|
    hub.vm.hostname = "hub"
    hub.vm.network "public_network", ip: "10.0.0.100", netmask: "255.255.255.0", bridge: bridge
    hub.vm.provider "vmware_desktop" do |v|
      v.vmx["numvcpus"] = "1"
      v.vmx["memsize"] = "1024"
    end
  end

  config.vm.define "client" do |client|
    client.vm.hostname = "client"
    client.vm.network "public_network", ip: "10.0.0.99", netmask: "255.255.255.0", bridge: bridge
    client.vm.disk :disk, name: "data", size: "20GB"
    client.vm.provider "vmware_desktop" do |v|
      v.vmx["numvcpus"] = "1"
      v.vmx["memsize"] = "1024"
    end

    client.vm.provision "shell", inline: <<-'SHELL'
      curl -o /etc/yum.repos.d/CentOS-Base.repo https://mirrors.aliyun.com/repo/Centos-7.repo
      curl -o /etc/yum.repos.d/epel.repo https://mirrors.aliyun.com/repo/epel-7.repo
      yum clean all && yum makecache
    SHELL

    client.vm.provision "shell", inline: <<-'SHELL'
      yum install ansible sshpass -y
    SHELL

    client.vm.provision "ansible_local" do |ansible|
      ansible.install = false
      ansible.playbook = "site.yml"
      ansible.inventory_path = "inventory.ini"
      ansible.limit = "localhost:all"
    end
  end
end
