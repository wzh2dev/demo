apiVersion: v1
kind: Config
clusters:
  - name: local
    cluster:
      server: https://10.0.0.3:6443
      certificate-authority: /cluster/pki/k8s/k8s.crt
users:
  - name: scheduler
    user:
      client-certificate: /cluster/pki/k8s/scheduler-client.crt
      client-key: /cluster/pki/k8s/scheduler-client.key
contexts:
  - name: scheduler@local
    context:
      cluster: local
      user: scheduler
current-context: scheduler@local
