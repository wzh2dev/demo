apiVersion: v1
kind: Config
clusters:
  - name: local
    cluster:
      server: https://10.0.0.3:6443
      certificate-authority: /cluster/pki/k8s/k8s.crt
users:
  - name: kube-proxy
    user:
      client-certificate: /cluster/pki/k8s/kube-proxy-client.crt
      client-key: /cluster/pki/k8s/kube-proxy-client.key
contexts:
  - name: kube-proxy@local
    context:
      cluster: local
      user: kube-proxy
current-context: kube-proxy@local
