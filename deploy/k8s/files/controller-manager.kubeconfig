apiVersion: v1
kind: Config
clusters:
  - name: local
    cluster:
      server: https://10.0.0.3:6443
      certificate-authority: /cluster/pki/k8s/k8s.crt
users:
  - name: cm
    user:
      client-certificate: /cluster/pki/k8s/controller-manager-client.crt
      client-key: /cluster/pki/k8s/controller-manager-client.key
contexts:
  - name: cm@local
    context:
      cluster: local
      user: cm
current-context: cm@local
