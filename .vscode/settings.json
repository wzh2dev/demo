{
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.exclude": {
    "**/.git": false,
    "**/.svn": false,
    "**/.hg": false,
    "**/.DS_Store": false,
    "**/Thumbs.db": false,
    ".codegraph": true,
    "**/.gitnexus": true
  },
  "files.watcherExclude": {
    "**/.git": true,
    "**/node_modules": true,
    ".codegraph": true,
    "**/.gitnexus": true,
    ".agents": true,
    ".trae": true
  },
  "search.exclude": {
    "**/node_modules": true,
    ".agents": true,
    ".trae": true
  },
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "redhat.telemetry.enabled": false,
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-17",
      "path": "/cluster/jdk-17.0.12.jdk/Contents/Home",
      "default": false
    }
  ],
  "maven.executable.path": "/cluster/maven/bin/mvn",
  "maven.executable.options": "-DskipTests",
  "maven.terminal.customEnv": [
    {
      "environmentVariable": "JAVA_HOME",
      "value": "/cluster/jdk-17.0.12.jdk/Contents/Home"
    }
  ],
  // "js/ts.tsserver.node.path": "E:\\node-v22.22.1-win-x64\\node",
  "python.defaultInterpreterPath": "E:\\python-3.8.9\\python",
  "extensions": {
    "ignoreRecommendations": true,
    "showRecommendationsOnlyOnDemand": false
  },
  "terminal.integrated.env.windows": {
    "a": "b"
  },
  "xml.format.preserveAttributeLineBreaks": false,
  "xml.format.preservedNewlines": 1,
  "xml.format.joinCDATALines": true,
  "xml.format.joinCommentLines": true,
  "[xml]": {
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "go.goroot": "/cluster/go",
  // for trae
  "workbench.colorTheme": "Light",
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.compile.nullAnalysis.mode": "automatic",
  "sqltools.connections": [
    {
      "mysqlOptions": {
        "authProtocol": "default",
        "enableSsl": "Disabled"
      },
      "ssh": "Disabled",
      "previewLimit": 50,
      "server": "xueyingying.com",
      "port": 3306,
      "driver": "MySQL",
      "name": "xueyingying.com",
      "database": "mysql",
      "username": "root",
      "password": "root"
    }
  ]
  // "typescript.tsserver.nodePath": "E:\\node-v22.22.1-win-x64\\node",
}
